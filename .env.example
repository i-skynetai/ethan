# ── Ethan service configuration ──────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit it.

# Router model (required): the LLM Ethan ROUTES with — not a KB. Small model is fine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini            # change to any chat model your key can use
# GEMINI_API_KEY=                  # optional, unused in v0.1

# Telegram door (required for the phone door)
TELEGRAM_BOT_TOKEN=                # from @BotFather
TELEGRAM_ALLOWED_USER_IDS=         # your numeric id; Ethan tells you it on first message

# KBs (each KB lists its pat_env in config/kb-map.json). A KB is one tenant:
# memory and knowledge. The 'brain' is the whole assembly — KB + model + skills
# + policy + tools — and is never a single file.
KB_MAIN_PAT=
KB_CLIENT_PAT=                  # optional until you use a second KB

# Relay to a running coding session (optional). The folder of an agent-bridge
# checkout; without it Ethan says it cannot reach a running session and sends nothing.
# ETHAN_BRIDGE_DIR=
# ETHAN_BRIDGE_DB=                 # the bridge's registry; default ~/.agent-bridge/bridge.db
